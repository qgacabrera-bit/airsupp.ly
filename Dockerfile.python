# ==============================================================
# AirSupp.ly - Multi-Purpose Python Container Image
# Shared by:
#   1. producer (Data Ingestion & Fallback Generator)
#   2. backend (FastAPI Async Middleware)
# ==============================================================
FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies (curl for healthchecks if needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install python dependencies
COPY requirements-python.txt /app/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy backend and producer source code
COPY backend/ /app/backend/
COPY producer/ /app/producer/
COPY spark/aqi_calculator.py /app/spark/aqi_calculator.py
COPY .env.example /app/.env.example

# Default command (overridden by docker-compose)
CMD ["python"]
