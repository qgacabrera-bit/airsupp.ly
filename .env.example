# ==========================================
# AirSupp.ly - Environment Configuration
# ==========================================

# Apache Kafka (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=air_supply_stream

# MongoDB 7.0 Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=airsupply_db
MONGO_LIVE_COLLECTION=live_metrics
MONGO_HISTORY_COLLECTION=history_logs

# OpenAQ API v3
# Optional: Get a free key at https://openaq.org
OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Ingestion Settings
POLL_INTERVAL_SECONDS=15

# FastAPI Backend Middleware
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Spark Structured Streaming
SPARK_CHECKPOINT_DIR=./.checkpoint/spark_stream
